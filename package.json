{
  "name": "oneset",
  "version": "0.1.0",
  "private": true,
  "description": "Write an app's actions once; people use them through the page, agents through MCP or a CLI.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./doors": {
      "types": "./dist/doors/index.d.ts",
      "default": "./dist/doors/index.js"
    },
    "./client": {
      "types": "./dist/doors/browser.d.ts",
      "default": "./dist/doors/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/doors/cli.mjs src/doors/browser.js src/doors/browser.d.ts dist/doors/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --test-reporter=spec --test-concurrency=1 --test-timeout=60000 'test/**/*.test.ts'",
    "pack:check": "node scripts/pack-check.mjs",
    "gate": "pnpm check && pnpm typecheck && pnpm build && pnpm test && pnpm pack:check"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
